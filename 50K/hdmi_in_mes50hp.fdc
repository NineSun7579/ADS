# ASSUMED source-synchronous budget, not a datasheet AC specification:
# MS7200 DVO/PCB arrivals are budgeted 0..4 ns after the incoming rising
# pixel-clock edge. FPGA captures the preceding cycle on its rising edge.
# 0 ns min deliberately assumes no external hold assistance. Register 0x1281
# stays at the supplied default bypass phase. Confirm with board measurement
# before interpreting these constraints as an AC-qualified interface.
# [native HDMI] The bus changes 0..4 ns after each rising pixclk_in edge and
# is captured by falling-edge IOB registers (pixclk_in <= 74.25 MHz).
set_input_delay -clock [get_clocks {pixclk_in}] -max {4.000} [get_ports {vs_in hs_in de_in r_in[*] g_in[*] b_in[*]}]
set_input_delay -clock [get_clocks {pixclk_in}] -min {0.000} [get_ports {vs_in hs_in de_in r_in[*] g_in[*] b_in[*]}]
