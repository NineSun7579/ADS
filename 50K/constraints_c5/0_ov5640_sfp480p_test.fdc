# [SLIM Rev3.2b] mrg_clk = clk2core_tx/2 (cam2_merge 读域 62.5M)
define_attribute {n:mrg_clk} {PAP_CLOCK_ASSIGN} {GTP_CLKBUFG}
# MS7200 input is an independent pixel-clock family. Only synchronized mode,
# reset-release and Gray FIFO pointers cross into the fixed merge/TX domains.
# [native HDMI] 30 fps native sources: pixel clock <= 74.25 MHz.
create_clock -name pixclk_in -period 13.468 [get_ports {pixclk_in}]
# Global PLL sample clock. Preserve the full 0..4ns external arrival budget.
# PDS User Guide section6.2.2 permits PLL rename-only constraints to retain
# inferred ratios/phase; do not impose a fictitious zero-phase divide-by-one.
# Rename inferred PLL outputs: PDS derives actual divider/physical phase.
# [native HDMI] removed: create_generated_clock -name hdmi_sample_clk -source [get_ports {pixclk_in}] [get_pins {u_hdmi_capture.u_input_pll/CLKOUT0}] -master_clock [get_clocks {pixclk_in}]
# [native HDMI] removed: create_generated_clock -name hdmi_feedback_clk -source [get_ports {pixclk_in}] [get_pins {u_hdmi_capture.u_input_pll/CLKOUT1}] -master_clock [get_clocks {pixclk_in}]
# [native HDMI] removed: set_clock_uncertainty {0.200} [get_clocks {hdmi_sample_clk hdmi_feedback_clk}] -setup -hold
# Separate these camera DE pipeline stages: co-packed FF3->FF0 was -5 ps
# hold in the fast corner. This placement adds physical routing separation.
define_attribute {i:cmos2_8_16bit.de_out3} {PAP_LOC} {CLMA_110_40:FF0}
define_attribute {i:cmos1_8_16bit.pdata_out3[9]} {PAP_LOC} {CLMA_218_120:FF0}
define_attribute {i:cmos2_8_16bit.pdata_o[12]} {PAP_LOC} {CLMA_122_104:FF0}
set_clock_uncertainty {0.200} [get_clocks {pixclk_in}] -setup -hold
# CDC exceptions target ONLY first-stage D pins. No clock-family cuts:
# second stages, local RAM address paths, and camera byte/div2 remain timed.
# timing_cdc.fdc selects compiled vector input bits at synthesis.
# Async assertion / local release: raw request reaches ONLY release_q[0].
# release_q[0] -> release_q[1] recovery/removal and D remain analyzed.
# FWFT FIFO held-data protocol: a word is committed before its Gray write
# pointer traverses two destination synchronizers and registered empty.
# The reader then samples a held word. Only RAM write-clock -> read-data
# arcs are exempt, not read-address -> destination or write-address timing.
# timing_cdc.fdc selects each FIFO's inferred memory launch cells and the
# receiving clock; PDS maps these exceptions to the physical LUTRAM arcs.
# HDMI input LOCs are in hdmi_in_mes50hp.fdc, verified against the original
# MES50HP 06_hdmi_loop final active block and hardware manual Table 3-6.
#[SLIM] single-group form replaced by the multi-group line above (cam2_merge CDC paths)
#[SLIM] set_clock_groups -name p_clk2core_tx_2 -asynchronous -group [get_clocks {p_clk2core_tx_2}]
#[SLIM] set_clock_groups -name ddrphy_clkin -asynchronous -group [get_clocks {ddrphy_clkin}]
