###==== BEGIN Clocks
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}
###==== BEGIN "Generated Clocks"
create_generated_clock -name {ddrphy_clkin} -source [get_ports {sys_clk}] [get_pins {u_DDR3_50H.I_GTP_CLKDIV/CLKDIVOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}
create_generated_clock -name {ioclk0} -source [get_ports {sys_clk}] [get_pins {u_DDR3_50H.I_GTP_IOCLKBUF_0/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk1} -source [get_ports {sys_clk}] [get_pins {u_DDR3_50H.I_GTP_IOCLKBUF_1/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk2} -source [get_ports {sys_clk}] [get_pins {u_DDR3_50H.I_GTP_IOCLKBUF_2/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk_gate_clk} -source [get_ports {sys_clk}] [get_pins {u_DDR3_50H.u_clkbufg_gate/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}
###==== BEGIN set_clock_uncertainty"
set_clock_uncertainty {0.200} [get_clocks {ddrphy_clkin}]  -setup -hold
###==== BEGIN set_clock_group"
# [2026-10-20] This section was a bare header with NO groups, so every DDR PHY
# clock was analysed synchronously against sys_clk. Measured consequence: 1690
# removal endpoints on the PHY asynchronous reset distribution - path class
# "async timing path", endpoint pin RS, 5.155 ns of pure clock-tree insertion
# difference (launch 5.095 / capture 10.954) that no router can close.
# The five lines below are verbatim from the 50K reference project
# (ov5640_sfp480p_test.fdc:516-519 and :775). The vendor DDR3_50H pnr reference
# (source/rtl/DDR3_50H/pnr/ddr_test.fdc:21-26) declares the same clocks async.
# No clock period, waveform or uncertainty is changed; no synchronous data path
# is exempted - these clocks carry only the PHY internal reset distribution.
set_clock_groups -name ddrphy_clkin   -asynchronous -group [get_clocks {ddrphy_clkin}]
set_clock_groups -name ioclk0         -asynchronous -group [get_clocks {ioclk0}]
set_clock_groups -name ioclk1         -asynchronous -group [get_clocks {ioclk1}]
set_clock_groups -name ioclk2         -asynchronous -group [get_clocks {ioclk2}]
set_clock_groups -name ioclk_gate_clk -asynchronous -group [get_clocks {ioclk_gate_clk}]
###==== BEGIN Attributes
define_attribute {i:u_DDR3_50H.u_ipsxb_ddrphy_pll_0.u_pll_e3} {PAP_LOC} {PLL_158_199}
define_attribute {i:u_DDR3_50H.u_ipsxb_ddrphy_pll_1.u_pll_e3} {PAP_LOC} {PLL_158_179}
define_attribute {i:u_DDR3_50H.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_150_192:FF3}
define_attribute {n:cmos2_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE} 
create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period {11.900} -waveform {0.000 5.950}
create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {11.900} -waveform {0.000 5.950}
create_generated_clock -name {cmos1_pclk_16bit} -source [get_ports {cmos1_pclk}] [get_pins {cmos1_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos1_pclk}] -divide_by {2}
create_generated_clock -name {cmos2_pclk_16bit} -source [get_ports {cmos2_pclk}] [get_pins {cmos2_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos2_pclk}] -divide_by {2}
set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk_16bit}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk_16bit}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}]  -setup -hold
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {49} -divide_by {66}
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT1}] -master_clock [get_clocks {sys_clk}] -multiply_by {49} -divide_by {246}
create_generated_clock -name {clk_25M} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT2}] -master_clock [get_clocks {sys_clk}] -divide_by {2}
###==== HSST fabric clock (125MHz) & location
create_clock -name {p_clk2core_tx_2} [get_pins {u_hsst.o_p_clk2core_tx_2}] -period {8.000} -waveform {0.000 4.000}
create_generated_clock -name {mrg_clk} -source [get_pins {u_hsst.o_p_clk2core_tx_2}] [get_nets {mrg_clk}] -master_clock [get_clocks {p_clk2core_tx_2}] -edges {2 4 6}
define_attribute {i:u_hsst.U_GTP_HSST_WRAPPER.U_GTP_HSST} {PAP_LOC} {HSST_88_340}
define_attribute {t:u_hsst.o_p_clk2core_tx_2} {PAP_CLOCK_ASSIGN} {GTP_CLKBUFG}

define_attribute {p:cmos1_data[7]} {PAP_IO_DIRECTION} {INPUT}
