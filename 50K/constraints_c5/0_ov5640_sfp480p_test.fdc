#[SLIM] define_attribute {p:b_out[3]} {PAP_IO_VCCIO} {3.3}
#[SLIM] define_attribute {p:b_out[3]} {PAP_IO_STANDARD} {LVCMOS33}
#[SLIM] define_attribute {p:b_out[3]} {PAP_IO_DRIVE} {8}
#[SLIM] define_attribute {p:b_out[3]} {PAP_IO_NONE} {TRUE}
