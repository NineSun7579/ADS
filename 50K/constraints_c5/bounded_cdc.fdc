set_max_delay -datapath_only -from [get_pins -hierarchical -regexp {(^u_legacy_video_tx/fifo/rptr(\[[0-9:]+\])?/Q\[[0-9]+\]$)|(^u_legacy_video_tx/fifo/rptr\[[0-9]+\]/opit_0(_inv|_srl)?/Q$)}] -to [get_pins -hierarchical -regexp {(^u_legacy_video_tx/fifo/rptr_wr1(\[[0-9:]+\])?/D\[[0-9]+\]$)|(^u_legacy_video_tx/fifo/rptr_wr1\[[0-9]+\]/opit_0(_inv|_srl)?/D$)}] 6.000
set_max_delay -datapath_only -from [get_pins -hierarchical -regexp {(^u_legacy_video_tx/fifo/g_bank\[[0-9]+\]\.mem/(DO|DOA|DOB)(\[[0-9]+\])?$)|(^u_legacy_video_tx/fifo/g_bank\[[0-9]+\]\.mem/iGopDrm_inv/DO(A|B)\[[0-9]+\]$)}] -to [get_clocks {p_clk2core_tx_2}] 6.000
# hdmi_active (mrg_clk) -> 125 MHz fabric copy: first synchronizer stage only.
set_false_path -to [get_pins -hierarchical -regexp {(^hdmi_active_sync(\[[0-9:]+\])?/D\[0\]$)|(^hdmi_active_sync\[0\]/opit_0(_inv|_srl)?/D$)}]
# Machine-readable diagnostics replace the removed u_diag LED sampler.
# Independent status bits: first-stage D only; native_status_sync stays timed.
set_false_path -to [get_pins -hierarchical -regexp {(^native_status_meta(\[[0-9:]+\])?/D\[[0-9]+\]$)|(^native_status_meta\[[0-9]+\]/opit_0(_inv|_srl)?/D$)}]
# Coherent 90-bit snapshot: two-stage toggle handshake plus a settling cycle.
set_false_path -to [get_pins -hierarchical -regexp {(^u_native_diag_sender/debug_cdc/req_sync(\[[0-9:]+\])?/D\[0\]$)|(^u_native_diag_sender/debug_cdc/req_sync\[0\]/opit_0(_inv|_srl)?/D$)}]
set_false_path -to [get_pins -hierarchical -regexp {(^u_native_diag_sender/debug_cdc/ack_sync(\[[0-9:]+\])?/D\[0\]$)|(^u_native_diag_sender/debug_cdc/ack_sync\[0\]/opit_0(_inv|_srl)?/D$)}]
# Same pclk -> 125 MHz bundle bound as native_capture/meta_cdc: 6 ns < 8 ns.
set_max_delay -datapath_only -from [get_pins -hierarchical -regexp {(^u_native_diag_sender/debug_cdc/held(\[[0-9:]+\])?/Q\[[0-9]+\]$)|(^u_native_diag_sender/debug_cdc/held\[[0-9]+\]/opit_0(_inv|_srl)?/Q$)}] -to [get_pins -hierarchical -regexp {(^u_native_diag_sender/debug_cdc/d_data(\[[0-9:]+\])?/D\[[0-9]+\]$)|(^u_native_diag_sender/debug_cdc/d_data\[[0-9]+\]/opit_0(_inv|_srl)?/D$)}] 6.000
# Local reset assertion: only stage-zero C/RS, matching release_q/sr/dr/mr above.
set_false_path -to [get_pins -hierarchical -regexp {(^u_native_diag_sender/(p_reset|out_reset)/release_q\[0\]/C$)|(^u_native_diag_sender/(p_reset|out_reset)/release_q\[0\]/opit_0(_inv|_srl)?/RS$)}]
